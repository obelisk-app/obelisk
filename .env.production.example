# Browser variables are embedded by `next build`; rebuild after changing them.
# Copy to .env.production (gitignored) on the production box. Nothing in
# this file is secret except the TURN credential; keep real values out of
# the example.

# Public origin of the site, used for canonical URLs, sitemap.xml and
# robots.txt. Despite the name it is not a CORS setting.
CORS_ORIGIN=https://obelisk.ar

# Comma-separated NIP-29 relays shown in the add-relay suggestions. No built-in defaults.
NEXT_PUBLIC_RECOMMENDED_RELAYS=

# TURN is required for mesh calls across symmetric NAT / carrier-grade NAT.
# Advertise both transports because some networks block UDP.
NEXT_PUBLIC_TURN_URLS=turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Debug only: force every mesh connection through TURN.
NEXT_PUBLIC_FORCE_RELAY=0

# Optional SFU pin. Leave empty to use signed kind 31313 advertisements.
NEXT_PUBLIC_SFU_PUBKEY=
NEXT_PUBLIC_SFU_URL=
NEXT_PUBLIC_SFU_RELAYS=
NEXT_PUBLIC_SFU_TRUSTED_RELAYS=

# Optional integrations.
NEXT_PUBLIC_GIPHY_API_KEY=

# Not read by the app. A token-run cloudflared (the pm2 `obelisk-dex-tunnel`
# process) may use it; scripts/raise.sh uses the credentials file instead.
TUNNEL_TOKEN=
